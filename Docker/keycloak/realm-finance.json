{
  "realm": "finance",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "attributes": {
    "frontendUrl": "http://localhost:8085"
  },
  "accessTokenLifespan": 18000,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 2592000,
  "clients": [
    {
      "clientId": "finance-gateway",
      "name": "finance-gateway",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["web-origins", "role_list", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "finance-portal",
      "name": "finance-portal",
      "enabled": true,
      "publicClient": false,
      "secret": "finance-portal-dev-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost/*"],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "18000"
      },
      "defaultClientScopes": ["web-origins", "role_list", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "USER" },
      { "name": "ADMIN" }
    ]
  },
  "users": [
    {
      "username": "user1",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "email": "user1@example.com",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "123456", "temporary": false }],
      "realmRoles": ["USER"]
    },
    {
      "username": "admin1",
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "email": "admin1@example.com",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "123456", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}
