# =============================================================================
# Docker/.env şablonu
#   1) cp .env.example .env   (Windows: Copy-Item .env.example .env)
#   2) Aşağıdaki "API ANAHTARLARI" bölümünü doldurun
#   3) docker compose up -d --build
#
# Öncelik: docker-compose.yml > bu dosya > application.yml
# Rehber: docs/turkce/getting-started.md
# =============================================================================


# -----------------------------------------------------------------------------
# API ANAHTARLARI — sizin doldurmanız gerekir
# -----------------------------------------------------------------------------
# • TCMB_API_KEY   → EVDS: tahvil, politika faizi, repo, TL mevduat, döviz
#   Boş bırakırsanız: docker compose up başlamaz
# • FINNHUB_API_KEY → NASDAQ canlı fiyat ve geçmiş veri
#   Boş bırakırsanız: stack kalkar, NASDAQ listesi/grafikleri boş kalır
# • OPENAI_API_KEY → yalnızca admin bilgi kartı AI için (isteğe bağlı)
#   Boş + AI_ENABLED=false: AI kapalı, diğer özellikler etkilenmez
TCMB_API_KEY=
FINNHUB_API_KEY=
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# VERİTABANI — demo varsayılanları (üretimde değiştirin)
# -----------------------------------------------------------------------------
# • POSTGRES_PASSWORD ile NEWS_DB_PASSWORD aynı olmalı
# • Şifre değiştirirseniz: mevcut volume ile uyumsuzluk olabilir → docker compose down -v
POSTGRES_PASSWORD=123456
NEWS_DB_PASSWORD=123456


# -----------------------------------------------------------------------------
# PİYASA VERİSİ — market-data-service (backfill + canlı ingest)
# -----------------------------------------------------------------------------
# application.yml’de false olanlar; Docker demo için true — ilk açılışta 1M–1Y kolonları dolar.
# • Değiştirirseniz: docker compose up -d --force-recreate market-data-service
# • PROVIDERS_FINNHUB_ENABLED=false → NASDAQ ingest kapanır
# • MARKET_HISTORY_BACKFILL_* false → BIST/NASDAQ geçmiş fiyat kolonları boş kalır
# • MARKET_FUND_* false → TEFAS fon NAV güncellenmez, kısa vadeli % “Delayed data” gösterir
# • MARKET_BOND_* / MARKET_TRGOVUSD_* false → tahvil / eurobond grafikleri eksik kalır
# • MARKET_VIOP_ENABLED=false → VIOP tahvil kartı boş kalır
# • MARKET_HISTORY_BACKFILL_GATE_LIVE_UNTIL_HISTORY_READY=true → canlı fiyat geçmiş dolana kadar gecikir
# • MARKET_EVDS_API_KEY satırı EKLEMEYİN veya boş bırakmayın — TCMB_API_KEY yedeği devreye girmez
PROVIDERS_FINNHUB_ENABLED=true
MARKET_HISTORY_BACKFILL_ENABLED=true
MARKET_HISTORY_BACKFILL_RUN_ON_STARTUP=true
MARKET_HISTORY_BACKFILL_GATE_LIVE_UNTIL_HISTORY_READY=false
MARKET_HISTORY_BACKFILL_STOCK_BOOTSTRAP_PARALLELISM=4
MARKET_FUND_NAV_HISTORY_BOOTSTRAP_ENABLED=true
MARKET_FUND_NAV_HISTORY_BOOTSTRAP_DELAY_MS=90000
MARKET_FUND_NAV_HISTORY_LOOKBACK_DAYS=365
MARKET_FUND_SCHEDULER_ENABLED=true
MARKET_BOND_HISTORY_BOOTSTRAP_ENABLED=true
MARKET_BOND_HISTORY_BOOTSTRAP_DELAY_MS=120000
MARKET_TRGOVUSD_HISTORY_BOOTSTRAP_ENABLED=true
MARKET_TRGOVUSD_HISTORY_REFRESH_ENABLED=true
MARKET_VIOP_ENABLED=true
MARKET_CPI_MONTHLY_SYNC_ENABLED=true
MARKET_POLICY_RATE_WEEKLY_SYNC_ENABLED=true
MARKET_REPO_RATE_SYNC_ENABLED=true
MARKET_TL_DEPOSIT_WEEKLY_SYNC_ENABLED=true
MARKET_HOT_READ_CACHE_ENABLED=true


# -----------------------------------------------------------------------------
# EUROBOND YAHOO — finance-api (TR USD tahvil kartı grafiği)
# -----------------------------------------------------------------------------
# • false → Faiz Vadeli eurobond grafikleri boş kalır (ücretsiz Yahoo chart)
# • Değiştirirseniz: docker compose up -d --force-recreate finance-api
MARKET_TR_USD_EUROBOND_YAHOO_ENABLED=true

# -----------------------------------------------------------------------------
# HABER — news-service (RSS çekme + çeviri + görsel)
# -----------------------------------------------------------------------------
# • Timeout değerlerini artırırsanız: yavaş kaynaklardan haber gelir, ingest uzar
# • NEWS_TRANSLATION_MYMEMORY_EMAIL doldurursanız: MyMemory çeviri kotası artar
# • NEWS_IMAGE_* false → haber kartlarında görsel eksik kalır
NEWS_RSS_CONNECT_TIMEOUT_MS=5000
NEWS_RSS_READ_TIMEOUT_MS=10000
NEWS_RSS_MAX_ENTRIES_PER_FEED=100
NEWS_RSS_USER_AGENT=finance-news-service/1.0
NEWS_TRANSLATION_MYMEMORY_EMAIL=
NEWS_IMAGE_ENABLED=true
NEWS_IMAGE_BACKFILL_ENABLED=true


# -----------------------------------------------------------------------------
# E-POSTA — kayıt doğrulama (finance-api) + alarm maili (notification-service)
# -----------------------------------------------------------------------------
# • Gmail: normal şifre değil → Google Hesap > Güvenlik > Uygulama şifreleri
# • Demo placeholder ile stack kalkar; gerçek değer yazana kadar mail gönderilmez
# • Değiştirirseniz: docker compose up -d --force-recreate finance-api notification-service
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SPRING_MAIL_USERNAME=your@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password
APP_REGISTRATION_VERIFICATION_FROM=your@gmail.com
NOTIFICATION_MAIL_FROM=your@gmail.com


# -----------------------------------------------------------------------------
# AI — finance-api admin bilgi kartı (isteğe bağlı)
# -----------------------------------------------------------------------------
# • AI_ENABLED=true + geçerli OPENAI_API_KEY → admin AI çalışır
# • AI_ENABLED=false → OpenAI anahtarı gerekmez
# • Değiştirirseniz: docker compose up -d --force-recreate finance-api
AI_ENABLED=false
OPENAI_MODEL_ADMIN_CONTENT=gpt-4.1-mini
OPENAI_MODEL_TRANSLATION=gpt-4.1-mini


# -----------------------------------------------------------------------------
# GÜVENLİK — demo ortamı (üretimde güçlü rastgele değerler kullanın)
# -----------------------------------------------------------------------------
# • Değiştirirseniz: mevcut MFA / güvenilir cihaz kayıtları geçersiz olabilir
APP_MFA_ENCRYPTION_SECRET=finance-mfa-dev-encryption-secret
APP_MFA_ISSUER=Finance Portal
APP_TRUSTED_DEVICE_SIGNING_SECRET=finance-trusted-device-dev-secret
APP_SECURITY_ALLOW_HEADER_USER_FALLBACK=true


# -----------------------------------------------------------------------------
# PORTAL / GATEWAY — yerel demo URL'leri
# -----------------------------------------------------------------------------
# • Farklı host/port kullanırsanız: CORS ve OIDC issuer uyumunu kontrol edin
JWT_ISSUER_URI=http://localhost:8085/realms/finance
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_PORTAL_PUBLIC_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# ANALİTİK — analytics-service
# -----------------------------------------------------------------------------
CLIENTS_FINANCE_AUTH_MODE=none
