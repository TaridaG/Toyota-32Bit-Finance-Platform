# CI / otomasyon için — gerçek anahtarlar GitHub Secrets üzerinden verilir.
# Yerel test: cp .env.ci-test .env

TCMB_API_KEY=ci-tcmb-placeholder
FINNHUB_API_KEY=ci-finnhub-placeholder
OPENAI_API_KEY=

POSTGRES_PASSWORD=123456
NEWS_DB_PASSWORD=123456

PROVIDERS_FINNHUB_ENABLED=true
MARKET_HISTORY_BACKFILL_ENABLED=true
MARKET_HISTORY_BACKFILL_RUN_ON_STARTUP=true
MARKET_HISTORY_BACKFILL_GATE_LIVE_UNTIL_HISTORY_READY=false
MARKET_FUND_NAV_HISTORY_BOOTSTRAP_ENABLED=true
MARKET_FUND_SCHEDULER_ENABLED=true
MARKET_BOND_HISTORY_BOOTSTRAP_ENABLED=true
MARKET_TRGOVUSD_HISTORY_BOOTSTRAP_ENABLED=true
MARKET_TRGOVUSD_HISTORY_REFRESH_ENABLED=true
MARKET_VIOP_ENABLED=true
MARKET_TR_USD_EUROBOND_YAHOO_ENABLED=true

NEWS_RSS_CONNECT_TIMEOUT_MS=5000
NEWS_RSS_READ_TIMEOUT_MS=10000
NEWS_RSS_MAX_ENTRIES_PER_FEED=100
NEWS_RSS_USER_AGENT=finance-news-service/1.0
NEWS_TRANSLATION_MYMEMORY_EMAIL=
NEWS_IMAGE_ENABLED=true
NEWS_IMAGE_BACKFILL_ENABLED=true

SMTP_USERNAME=
SMTP_PASSWORD=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_REGISTRATION_VERIFICATION_FROM=
NOTIFICATION_MAIL_FROM=

AI_ENABLED=false
OPENAI_MODEL_ADMIN_CONTENT=gpt-4.1-mini
OPENAI_MODEL_TRANSLATION=gpt-4.1-mini

APP_MFA_ENCRYPTION_SECRET=finance-mfa-dev-encryption-secret
APP_MFA_ISSUER=Finance Portal
APP_TRUSTED_DEVICE_SIGNING_SECRET=finance-trusted-device-dev-secret
APP_SECURITY_ALLOW_HEADER_USER_FALLBACK=true

JWT_ISSUER_URI=http://localhost:8085/realms/finance
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_PORTAL_PUBLIC_URL=http://localhost:5173

CLIENTS_FINANCE_AUTH_MODE=none
