  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "HTTP istek hızı ($job)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\", uri!=\"/actuator/prometheus\"}[5m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 4,
      "title": "Ortalama cevap süresi ($job)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=~\"$job\", uri!=\"/actuator/prometheus\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=~\"$job\", uri!=\"/actuator/prometheus\"}[5m]))",
          "legendFormat": "avg s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "title": "Hata oranı 5xx (platform)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\", uri!=\"/actuator/prometheus\"}[5m])) / sum(rate(http_server_requests_seconds_count{uri!=\"/actuator/prometheus\"}[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "title": "Service health (up)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 2,
      "title": "Log consumer — işlenen Kafka log olayları",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kafka_events_processed_total[5m]))",
          "legendFormat": "processed/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 16 },
      "id": 3,
      "title": "OpenSearch index hataları (log-consumer)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kafka_events_opensearch_failed_total[5m]))",
          "legendFormat": "failures/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 7,
      "title": "Log pipeline — DLQ",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kafka_events_dlq_published_total[5m]))",
          "legendFormat": "dlq/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 8,
      "title": "Log pipeline — atlanan / başarısız",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kafka_events_skipped_total[5m]))",
          "legendFormat": "skipped/s"
        },
        {
          "expr": "sum(rate(kafka_events_failed_total[5m]))",
          "legendFormat": "failed/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 9,
      "title": "JVM heap ($job)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=~\"$job\", area=\"heap\"}) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 10,
      "title": "Heap kullanım oranı ($job)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=~\"$job\", area=\"heap\"}) by (job) / sum(jvm_memory_max_bytes{job=~\"$job\", area=\"heap\"}) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 11,
      "title": "GC pause (ortalama, $job)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=~\"$job\"}[5m])) by (job) / sum(rate(jvm_gc_pause_seconds_count{job=~\"$job\"}[5m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ],
