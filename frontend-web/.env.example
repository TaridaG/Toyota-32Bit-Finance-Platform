# Yerel gelistirme: bu dosyayi .env.development olarak kopyalayin (npm run dev).
#
# Docker varsayilan (frontend-web): nginx + vite build — .env.development gerekmez;
#   /api same-origin uzerinden nginx -> api-gateway proxy edilir.
# Docker UI HMR: docker compose --profile dev -> frontend-web-dev :5174, asagidaki VITE_* kullanilir.

# Optional: call APIs directly (bypasses Vite proxy). Leave empty in dev to use same-origin + proxy.
# VITE_API_BASE_URL=http://localhost:8080

# finance-api (default Vite /api target; includes BFF proxy to market-data-service)
# VITE_PROXY_TARGET=http://localhost:8080

# Optional: direct browser → MDS for /api/market (debug). Default is off; finance-api proxies instead.
# VITE_MARKET_PROXY_TARGET=http://localhost:8082
# VITE_DEV_MARKET_DIRECT_TO_MDS=true

# If true, all /api goes to VITE_PROXY_TARGET only (API gateway in Docker dev profile).
# VITE_DEV_PROXY_GATEWAY=true
