# npm run dev — Vite tüm /api → finance-api :8080; piyasa uçları finance-api içinden MDS :8082'ye gider.
# Piyasa verisi için market-data-service'i ayrıca çalıştırın (Kafka localhost:9092).

VITE_PROXY_TARGET=http://localhost:8080
VITE_MARKET_PROXY_TARGET=http://localhost:8082

# Doğrudan tarayıcıdan MDS'ye proxy (eski davranış). Varsayılan: kapalı.
# VITE_DEV_MARKET_DIRECT_TO_MDS=true

# Docker Compose frontend / tam gateway ile çalışırken:
# VITE_DEV_PROXY_GATEWAY=true
