{
  "@timestamp": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
      "timeZone": "UTC"
    }
  },
  "level": {
    "$resolver": "level",
    "field": "name"
  },
  "message": {
    "$resolver": "message",
    "stringified": true
  },
  "logger_name": {
    "$resolver": "logger",
    "field": "name"
  },
  "thread_name": {
    "$resolver": "thread",
    "field": "name"
  },
  "service": {
    "$resolver": "pattern",
    "pattern": "${spring:spring.application.name:-unknown}"
  },
  "traceId": {
    "$resolver": "mdc",
    "key": "traceId"
  },
  "correlationId": {
    "$resolver": "mdc",
    "key": "correlationId"
  },
  "stack_trace": {
    "$resolver": "exception",
    "field": "stackTrace",
    "stackTrace": {
      "stringified": true
    }
  }
}
